# Copy to .env (never commit .env) or set these in the environment.

# Which config to load: development (default), production, or testing.
PROJECT_TRACKER_CONFIG=development

# Required in production. Generate with:
#   python3 -c 'import secrets; print(secrets.token_hex())'
SECRET_KEY=

# SQLAlchemy database URL. Required in production; use an absolute path outside the
# repository checkout (note the four slashes), for example:
#   DATABASE_URL=sqlite:////var/lib/project-tracker/project_tracker.db
# In development it defaults to instance/project_tracker.db.
DATABASE_URL=

# Address Gunicorn listens on (read by gunicorn.conf.py). Defaults: 127.0.0.1 and
# 8002. Use 0.0.0.0 on the server to accept connections from the LAN and tailnet.
PROJECT_TRACKER_HOST=
PROJECT_TRACKER_PORT=
